{
  "name": "word-better-pdf-export",
  "version": "0.1.0",
  "private": true,
  "description": "Word add-in that exports to PDF through Word's native exporter and then restores the original, uncompressed images in the resulting PDF.",
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop --document ./file-sample.docx",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "make-test-pdf": "tsx scripts/make-test-pdf.ts",
    "fix-pdf": "tsx scripts/fix-pdf.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/office-js": "^1.0.377",
    "@types/pngjs": "^6.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "jpeg-js": "^0.4.4",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "pngjs": "^7.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.2",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
