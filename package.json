{
  "name": "word-better-pdf-export",
  "version": "0.1.0",
  "private": true,
  "description": "Word add-in that exports to PDF through Word's native exporter and then restores the original, uncompressed images in the resulting PDF.",
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop --document ./file-sample.docx",
    "stop": "office-addin-debugging stop manifest.xml",
    "register:prod": "tsx scripts/register-prod.ts register",
    "unregister:prod": "tsx scripts/register-prod.ts unregister",
    "validate": "office-addin-manifest validate manifest.xml",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "make-test-pdf": "tsx scripts/make-test-pdf.ts",
    "fix-pdf": "tsx scripts/fix-pdf.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/office-js": "^1.0.609",
    "@types/pngjs": "^6.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jpeg-js": "^0.4.4",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-dev-settings": "^4.0.0",
    "office-addin-manifest": "^3.0.0",
    "pngjs": "^7.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "homepage": "https://rakantor.github.io/word-better-pdf-export/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rakantor/word-better-pdf-export.git"
  },
  "bugs": {
    "url": "https://github.com/Rakantor/word-better-pdf-export/issues"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "qs": "^6.16.0"
  }
}
